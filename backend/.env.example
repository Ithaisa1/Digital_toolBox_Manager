DATABASE_URL="postgresql://user:password@localhost:5432/dexa_manager?schema=public"
JWT_SECRET="your-secret-key-change-in-production"
JWT_EXPIRES_IN="7d"
NODE_ENV="development"
PORT=3001

# Email (restablecer contraseña y avisos de renovación)
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT=587
EMAIL_USER="your-email@gmail.com"
EMAIL_PASSWORD="your-app-password"
# Remitente de los emails (opcional, por defecto EMAIL_USER)
# EMAIL_FROM="Dexa Manager <your-email@gmail.com>"

# Avisos de renovación
# Secreto que debe enviar el cron en "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET="change-me-long-random-string"
# Días de antelación del aviso (por defecto 7)
REMINDER_DAYS=7

# Frontend URL for email links
FRONTEND_URL="http://localhost:3000"

# External webhook (n8n or similar)
WEBHOOK_URL=""

# Al arrancar: migraciones + conexión Prisma + seed si no hay usuarios
AUTO_DB_SETUP=true
# Reintentos de conexión (opcional, por defecto 5 intentos cada 2s)
# DB_CONNECT_RETRIES=5
# DB_CONNECT_DELAY_MS=2000
# true = always seed | false = never | unset = seed only when there are no users
# AUTO_SEED=
